{
  "manifest_version": 3,
  "name": "Muse Web Collector",
  "version": "0.3.8",
  "key": "",
  "description": "将用户主动选择的网页图片保存到本机 Muse 素材库。",
  "permissions": ["contextMenus", "storage", "activeTab", "scripting", "nativeMessaging"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/imageContextMenu.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": { "default_title": "Muse Web Collector", "default_popup": "src/popup/popup.html" }
}
